  "key": 18231,
  "messages": [
    {
      "id": "SurvivalArea_Text_ThisIsMyPlace",
      "en_US": [
        "Buck: Yo, if it isn’t {STRVAR_1 3, 0, 0}!\r",
        "This! It’s my place!\n",
        "Drop in, hey?\r"
      ]
    },
    {
      "id": "SurvivalArea_Text_DoorMembersOnly",
      "en_US": [
        "The door is shut tight.\n",
        "“Members Only” is painted on it."
      ]
    },
    {
      "id": "SurvivalArea_Text_IllProveImTougher",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: Hey, {STRVAR_1 3, 1, 0}! You\n",
        "aren’t the only one getting tougher!\r",
        "I’ll prove it to you!\n",
        "Let’s go!\r"
      ]
    },
    {
      "id": "SurvivalArea_Text_KeepGettingTougher",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: ...!\r",
        "It’s all right, though.\n",
        "There’s no end to Pokémon.\n"
      ]
    },
    {
      "id": "SurvivalArea_Text_PilingUpWins",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: Hey, {STRVAR_1 3, 1, 0}!\n",
        "How are you doing?\r"
      ]
    },
    {
      "id": "SurvivalArea_Text_DidYouBattleEveryone",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: Oh, it’s you,\n",
        "{STRVAR_1 3, 1, 0}.\r"
      ]
    },
    {
      "id": "SurvivalArea_Text_BestTrainersLovePokemon",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: ...!\n",
        "Oh, it’s you, {STRVAR_1 3, 1, 0}.\r",
        "You know, the best Trainers must really\n",
        "love Pokémon from their heart.\r"
      ]
    },
    {
      "id": "SurvivalArea_Text_BagFullOfItems",
      "en_US": [
        "Hey, traveling Trainer.\n",
        "Is your big Bag full of items?\f",
        "Or is it full of dreams?"
      ]
    },
    {
      "id": "SurvivalArea_Text_ComeHereToTrain",
      "en_US": [
        "Trainers who lose at the Battle\n",
        "Frontier come here to train."
      ]
    },
    {
      "id": "SurvivalArea_Text_ScoreCommemorativePrints",
      "en_US": [
        "I’m taking the Frontier challenges to\n",
        "score some commemorative prints."
      ]
    },
    {
      "id": "SurvivalArea_Text_IFilmedRedGyarados",
      "en_US": [
        "I’m a Cameraman, obviously.\r",
        "Have you seen that TV program,\n",
        "“Search for the Red GYARADOS!”?\r",
        "Yeah, that outstanding documentary!\n",
        "I filmed that!"
      ]
    },
    {
      "id": "SurvivalArea_Text_AllSetToProduce",
      "en_US": [
        "I’m a Cameraman, obviously.\r",
        "“The Eruption of Stark Mountain?\n",
        "The mystery of the fiery Pokémon\f",
        "asleep deep in the volcano!”\r",
        "I was all set to produce that\n",
        "documentary, but it’s a no go.\r",
        "There’s not much of a show without\n",
        "capturing HEATRAN on film.\r",
        "Oh, well. The world’s a huge place.\n",
        "There’re plenty of other mysteries!"
      ]
    },
    {
      "id": "SurvivalArea_Text_AllMappedOut",
      "en_US": [
        "I’m a Cameraman, obviously.\r",
        "“The Eruption of Stark Mountain?\n",
        "The mystery of the fiery Pokémon\f",
        "asleep deep in the volcano!”\r",
        "I’ve had that documentary all mapped\n",
        "out in my head for a long time...\r",
        "But I have nothing on film as of yet.\n",
        "So much for that show.\r",
        "Oh, well. The world’s a huge place.\n",
        "There’re plenty of other mysteries!"
      ]
    },
    {
      "id": "SurvivalArea_Text_MapSign",
      "en_US": [
        "Survival Area\n",
        "Staging Point"
      ]
    }
  ]
}
