  "messages": [
    {
      "id": "AcuityLakefront_Text_CantClimbWithoutBadge",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: Hey, {STRVAR_1 3, 1, 0}!\n",
        "Slooow! Way too slow!\r",
        "Anyway, I’m off.\n",
        "Team Galactic! I’m coming for you!\r"
      ]
    },
    {
      "id": "AcuityLakefront_Text_MakeSureNoDisturbance",
      "en_US": [
        "We’re here to make sure Snowpoint’s\n",
        "Gym Leader doesn’t disturb us!"
      ]
    },
    {
      "id": "AcuityLakefront_Text_YouMustBeBored",
      "en_US": [
        "You’re here to see the lake Pokémon,\n",
        "too?\r",
        "You must be bored to fight your\n",
        "way through the snow to get here..."
      ]
    },
    {
      "id": "AcuityLakefront_Text_StandingGuardIsImportant",
      "en_US": [
        "Standing guard is a very important\n",
        "assignment!\r",
        "I’ll make this a success and earn\n",
        "myself a CLEFAIRY!"
      ]
    },
    {
      "id": "AcuityLakefront_Text_LakePokemonConnected",
      "en_US": [
        "The Pokémon of the three lakes\n",
        "appear to be connected somehow.\r",
        "When they blew up Lake Valor, a cavern\n",
        "appeared in the middle of this lake!"
      ]
    },
    {
      "id": "AcuityLakefront_Text_SignLakeAcuityAhead",
      "en_US": "Lake Acuity ahead"
    }
  ]
}
